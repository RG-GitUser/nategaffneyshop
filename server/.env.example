# ──────────────────────────────────────────────────────────────
#  API server environment
#
#  NONE of these belong in the frontend. Everything here stays on the
#  server. On DigitalOcean App Platform set them as encrypted env vars;
#  on a Droplet keep them in a .env that is NOT committed.
# ──────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080

# Public site origin(s), comma separated. CORS rejects everything else,
# so an attacker's page can't call this API using Nate's session.
ALLOWED_ORIGINS=https://nategaffney.com,https://www.nategaffney.com

# ── MongoDB ───────────────────────────────────────────────────
# Atlas or DigitalOcean Managed MongoDB. Must include the database name.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/nategaffneyshop
MONGODB_DB=nategaffneyshop

# ── Supabase (auth + image storage) ───────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Used to verify the JWT the browser sends. Supabase dashboard →
# Project Settings → API → JWT Secret. NEVER expose this.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Service role key — full database/storage access, bypasses RLS.
# Server only. Leaking this is equivalent to leaking the whole project.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket for uploaded images. Create it in Supabase → Storage.
SUPABASE_BUCKET=site-media

# ── Who is allowed in ─────────────────────────────────────────
# Comma-separated allowlist. A valid Supabase login is NOT enough — the
# account's email must also appear here. Anyone signing up to the
# Supabase project without being listed gets 403 on every admin route.
ADMIN_EMAILS=nate@example.com

# ── Stripe ────────────────────────────────────────────────────
# Secret key. Server only, forever. If this ends up in frontend code,
# anyone can refund, read customer data, and create charges.
STRIPE_SECRET_KEY=sk_live_xxx
