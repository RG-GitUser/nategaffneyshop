# ──────────────────────────────────────────────────────────────
#  API server environment
#
#  NONE of these belong in the frontend. Everything here stays on the
#  DigitalOcean server. Keep this file's real counterpart (.env) out of
#  git — it already is, via .gitignore.
# ──────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080

# Public site origin(s), comma separated — your Namecheap domain.
# CORS rejects everything else, so another site can't call this API
# using Nate's logged-in session.
ALLOWED_ORIGINS=https://nategaffney.com,https://www.nategaffney.com

# ── MongoDB ───────────────────────────────────────────────────
# The same connection string you point MongoDB Compass at.
# Local to the droplet:   mongodb://127.0.0.1:27017
# With auth:              mongodb://user:pass@127.0.0.1:27017/?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=nategaffneyshop

# ── Sessions ──────────────────────────────────────────────────
# Signs the admin login cookie. Generate a fresh one, never reuse:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs everyone out immediately, which is the fastest way to
# kill all sessions if something ever looks wrong.
JWT_SECRET=replace-me-with-64-random-hex-characters

# How long a login lasts before it has to be repeated.
SESSION_HOURS=12

# Cookie domain. Set this so the cookie works across your subdomains
# (site on nategaffney.com, API on api.nategaffney.com). Leave blank
# if the API is served from the same host as the site.
COOKIE_DOMAIN=.nategaffney.com

# ── Uploads ───────────────────────────────────────────────────
# Absolute path on the droplet where uploaded images are written.
# Must be on persistent disk and writable by the node process.
UPLOAD_DIR=/var/www/nategaffneyshop/uploads

# Public URL those files are reachable at. Either this API
# (https://api.nategaffney.com/uploads) or a path your web server maps
# to UPLOAD_DIR.
UPLOAD_PUBLIC_URL=https://api.nategaffney.com/uploads

# ── Email (Namecrane SMTP) ────────────────────────────────────
# From your Namecrane mail settings. Port 465 = implicit TLS,
# 587 = STARTTLS. Leave SMTP_HOST blank to disable email entirely —
# bookings still work, they just don't send notifications.
SMTP_HOST=mail.nategaffney.com
SMTP_PORT=465
SMTP_USER=hello@nategaffney.com
SMTP_PASS=your-mailbox-password
MAIL_FROM="Nate Gaffney <hello@nategaffney.com>"

# Where new booking requests get announced.
ADMIN_NOTIFY_EMAIL=hello@nategaffney.com

# ── Google Calendar + Meet ────────────────────────────────────
# Optional. Without it, paste a Meet link into each booking by hand.
# With it, confirming a booking creates a calendar event, mints a Meet
# room, and Google emails the invite.
#
# Google Cloud Console → APIs & Services:
#   1. Enable the Google Calendar API
#   2. OAuth consent screen → External → add yourself as a test user
#      (or publish it; only Nate ever signs in)
#   3. Credentials → OAuth client ID → Web application
#   4. Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.nategaffney.com/api/google/callback

# Which calendar to write to. "primary" is the account's own calendar.
GOOGLE_CALENDAR_ID=primary
# IANA zone the session times are written in.
GOOGLE_TIMEZONE=America/Halifax
# How long a session runs, used to set the event's end time.
SESSION_MINUTES=45

# ── Circle.so community chat ──────────────────────────────────
# Both tokens are secrets — Circle's own docs say not to expose these
# client-side. Leave CIRCLE_HEADLESS_TOKEN blank to switch the chat
# section off entirely; the rest of the site is unaffected.
#
# Community dashboard → Developers → Tokens. The headless token must be
# named "Headless" for Circle's auth API to accept it.
CIRCLE_HEADLESS_TOKEN=
# Admin API v2 token — used only to create a community member for someone
# joining for the first time. Optional; without it, only people already in
# the community can join the chat.
CIRCLE_ADMIN_TOKEN=
# Numeric id of the space people are added to when they join.
CIRCLE_SPACE_ID=
# UUID of the group chat room the widget reads and posts to.
CIRCLE_CHAT_ROOM_UUID=

# ---- Stripe ----
# Optional — leave blank and the Payments tab reports itself unconfigured
# while everything else runs normally.
#
# STRIPE_SECRET_KEY is the PLATFORM key (Connect) or your own account's
# key (standalone). Server only, forever.
STRIPE_SECRET_KEY=

# Stripe Connect: the connected account this site sells for. Every Stripe
# call is made on its behalf. Leave blank for a standalone account.
STRIPE_ACCOUNT_ID=

# Refund behaviour, which depends on your charge type.
#   Direct charges (charge lives on the connected account): leave both false.
#   Destination or separate transfers (charge lives on the platform):
#     set STRIPE_REVERSE_TRANSFER=true so funds come back from the
#     connected account, and STRIPE_REFUND_APPLICATION_FEE=true if you
#     also want to return your platform fee.
# Getting this wrong does not fail loudly - it refunds the customer while
# leaving money on the wrong side of the ledger.
STRIPE_REVERSE_TRANSFER=false
STRIPE_REFUND_APPLICATION_FEE=false

# Webhook signing secret. Without it the webhook route refuses every
# request, because an unverified endpoint would accept a forged
# "payment succeeded" from anyone who found the URL.
#
# Easiest: register it with the key already in this file —
#   npm run setup-webhook
# prints the secret to paste here (shown once by Stripe, so keep it).
# On Connect it creates a platform endpoint with connect: true; the
# handler filters events down to STRIPE_ACCOUNT_ID.
STRIPE_WEBHOOK_SECRET=