# Everything is stored with LF in the repository.
#
# This project is authored on Windows but deployed to Linux, and CRLF in a
# config file is not a cosmetic problem: nginx reports
# `unknown directive "#"` because the carriage return becomes part of the
# previous token, and systemd unit files fail the same way.
* text=auto eol=lf

# Shell scripts and server config must be LF, always.
*.sh    text eol=lf
*.conf  text eol=lf
*.service text eol=lf
*.env   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows-native files legitimately want CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Never touch binaries.
*.jpg   binary
*.jpeg  binary
*.png   binary
*.webp  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
