# ──────────────────────────────────────────────────────────────
#  FRONTEND environment (Vite)
#
#  Everything here is compiled INTO THE BROWSER BUNDLE and is publicly
#  readable. Only ever put values here that are safe to publish.
#
#  Never put in this file:
#    - STRIPE_SECRET_KEY        (would let anyone refund / charge)
#    - SUPABASE_SERVICE_ROLE_KEY (full database access)
#    - MONGODB_URI               (full database access)
#    - SUPABASE_JWT_SECRET       (would let anyone forge an admin login)
#  Those belong in server/.env only.
# ──────────────────────────────────────────────────────────────

# Where the API server lives. Leave blank in dev to use the Vite proxy.
VITE_API_URL=https://api.nategaffney.com

# Supabase project URL and ANON key. The anon key is designed to be public;
# it grants nothing on its own, and every admin route on the server verifies
# the JWT and checks the email allowlist independently.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
